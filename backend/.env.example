# Variables de entorno para backend

# Obligatoria. Consíguela en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="tu_anthropic_api_key"

# Obligatoria en producción. Firma los tokens de sesión.
# Genérala con: openssl rand -hex 32
JWT_SECRET="cambia_esto_por_una_cadena_aleatoria_larga"

# Debe coincidir con el puerto mapeado en docker-compose.yml
PORT=5000

SQLITE_DB_PATH="./db/clinical.sqlite"

#ANTHROPIC_MODEL=claude-sonnet-5
#ANTHROPIC_MODEL=claude-opus-4-8
